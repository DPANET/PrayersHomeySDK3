{
  "id": "hijri_specific_date",
  "title": { "en": "On Hijri date" },
  "titleFormatted": { "en": "On [[day]] [[month]] Hijri" },
  "hint": { "en": "Fires once a year on a specific Hijri day and month." },
  "args": [
    {
      "name": "day",
      "type": "number",
      "title": { "en": "Day" },
      "placeholder": { "en": "10" },
      "min": 1,
      "max": 30
    },
    {
      "name": "month",
      "type": "dropdown",
      "title": { "en": "Month" },
      "values": [
        { "id": "1",  "title": { "en": "Muharram" } },
        { "id": "2",  "title": { "en": "Safar" } },
        { "id": "3",  "title": { "en": "Rabi Al-Awwal" } },
        { "id": "4",  "title": { "en": "Rabi Al-Thani" } },
        { "id": "5",  "title": { "en": "Jumada Al-Awwal" } },
        { "id": "6",  "title": { "en": "Jumada Al-Thani" } },
        { "id": "7",  "title": { "en": "Rajab" } },
        { "id": "8",  "title": { "en": "Sha'ban" } },
        { "id": "9",  "title": { "en": "Ramadan" } },
        { "id": "10", "title": { "en": "Shawwal" } },
        { "id": "11", "title": { "en": "Dhul Qa'dah" } },
        { "id": "12", "title": { "en": "Dhul Hijjah" } }
      ]
    }
  ],
  "tokens": [
    { "name": "hijriDay",       "type": "number", "title": { "en": "Day" }, "example": { "en": "10" } },
    { "name": "hijriMonthName", "type": "string", "title": { "en": "Month name" }, "example": { "en": "Dhul Hijjah" } },
    { "name": "hijriYear",      "type": "number", "title": { "en": "Hijri year" }, "example": { "en": "1447" } },
    { "name": "gregorianDate",  "type": "string", "title": { "en": "Gregorian date" }, "example": { "en": "2025-06-06" } }
  ]
}
