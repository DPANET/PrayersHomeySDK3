{
  "id": "prayer_trigger_before_after_specific",
  "title": { "en": "Before or After Prayer" },
  "titleFormatted": { "en": "[[prayerAfterBefore]] [[prayerName]] by [[prayerDurationTime]] [[prayerDurationType]]" },
  "hint": { "en": "Fires before or after a prayer time. Use the Prayer Name and Alert Time tags in your Then cards." },
  "args": [
    {
      "name": "prayerAfterBefore",
      "type": "dropdown",
      "title": { "en": "Before or after" },
      "values": [
        { "id": "Before", "title": { "en": "Before" } },
        { "id": "After",  "title": { "en": "After"  } }
      ]
    },
    {
      "name": "prayerName",
      "type": "dropdown",
      "title": { "en": "Prayer" },
      "values": [
        { "id": "Fajr",    "title": { "en": "Fajr"    } },
        { "id": "Sunrise", "title": { "en": "Sunrise"  } },
        { "id": "Dhuhr",   "title": { "en": "Dhuhr"   } },
        { "id": "Asr",     "title": { "en": "Asr"     } },
        { "id": "Maghrib", "title": { "en": "Maghrib"  } },
        { "id": "Isha",    "title": { "en": "Isha"    } }
      ]
    },
    {
      "name": "prayerDurationTime",
      "type": "number",
      "title": { "en": "Number" },
      "placeholder": { "en": "0" },
      "min": 0,
      "max": 1440
    },
    {
      "name": "prayerDurationType",
      "type": "dropdown",
      "title": { "en": "Unit" },
      "values": [
        { "id": "seconds", "title": { "en": "second(s)" } },
        { "id": "minutes", "title": { "en": "minute(s)" } },
        { "id": "hours",   "title": { "en": "hour(s)"   } }
      ]
    }
  ],
  "tokens": [
    {
      "name": "prayerName",
      "type": "string",
      "title": { "en": "Prayer Name" },
      "example": { "en": "Fajr" }
    },
    {
      "name": "prayerTimeCalculated",
      "type": "string",
      "title": { "en": "Alert Time" },
      "example": { "en": "05:28" }
    },
    { "name": "adhan_full",     "type": "string", "title": { "en": "Full adhan URL" },     "example": { "en": "Full adhan audio link" } },
    { "name": "adhan_short",    "type": "string", "title": { "en": "Short adhan URL" },    "example": { "en": "Short adhan audio link" } },
    { "name": "adhkar_morning", "type": "string", "title": { "en": "Morning Adhkar URL" }, "example": { "en": "Morning adhkar audio link" } },
    { "name": "adhkar_evening", "type": "string", "title": { "en": "Evening Adhkar URL" }, "example": { "en": "Evening adhkar audio link" } },
    { "name": "quran",          "type": "string", "title": { "en": "Quran URL" },          "example": { "en": "Quran recitation audio link" } },
    { "name": "reciter",        "type": "string", "title": { "en": "Reciter" },            "example": { "en": "Mishary Al-Afasy" } },
    { "name": "custom",         "type": "string", "title": { "en": "Custom URL" },         "example": { "en": "Custom audio link 1" } },
    { "name": "custom2",        "type": "string", "title": { "en": "Custom URL 2" },       "example": { "en": "Custom audio link 2" } },
    { "name": "custom3",        "type": "string", "title": { "en": "Custom URL 3" },       "example": { "en": "Custom audio link 3" } },
    { "name": "volume",         "type": "number", "title": { "en": "Volume (0-1)" },       "example": 0.7 }
  ]
}
