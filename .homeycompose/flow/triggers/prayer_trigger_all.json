{
  "id": "prayer_trigger_all",
  "title": { "en": "At any prayer time" },
  "hint": { "en": "Fires at every prayer time (Fajr, Dhuhr, Asr, Maghrib, Isha). In your Then 'cast a URL' card, pick the audio tag you want — Full adhan, Short adhan, Adhkar, Quran or Custom. The app fills each tag from your Audio settings." },
  "tokens": [
    {
      "name": "prayerName",
      "type": "string",
      "title": { "en": "Prayer Name" },
      "example": { "en": "Fajr" }
    },
    {
      "name": "prayerTime",
      "type": "string",
      "title": { "en": "Prayer Time" },
      "example": { "en": "05:38" }
    },
    { "name": "adhan_full",     "type": "string", "title": { "en": "Full adhan URL" },     "example": { "en": "Full adhan audio link" } },
    { "name": "adhan_short",    "type": "string", "title": { "en": "Short adhan URL" },    "example": { "en": "Short adhan audio link" } },
    { "name": "adhkar_morning", "type": "string", "title": { "en": "Morning Adhkar URL" }, "example": { "en": "Morning adhkar audio link" } },
    { "name": "adhkar_evening", "type": "string", "title": { "en": "Evening Adhkar URL" }, "example": { "en": "Evening adhkar audio link" } },
    { "name": "quran",          "type": "string", "title": { "en": "Quran URL" },          "example": { "en": "Quran recitation audio link" } },
    { "name": "reciter",        "type": "string", "title": { "en": "Reciter" },            "example": { "en": "Mishary Al-Afasy" } },
    { "name": "custom",         "type": "string", "title": { "en": "Custom URL" },         "example": { "en": "Custom audio link 1" } },
    { "name": "custom2",        "type": "string", "title": { "en": "Custom URL 2" },       "example": { "en": "Custom audio link 2" } },
    { "name": "custom3",        "type": "string", "title": { "en": "Custom URL 3" },       "example": { "en": "Custom audio link 3" } },
    { "name": "volume",         "type": "number", "title": { "en": "Volume (0-1)" },       "example": 0.7 }
  ]
}
