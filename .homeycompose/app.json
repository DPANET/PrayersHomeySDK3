{
  "id": "com.prayerssapp",
  "version": "2.2.0",
  "compatibility": ">=12.1.0",
  "sdk": 3,
  "platforms": ["local"],
  "name": { "en": "Prayers Alert" },
  "description": { "en": "Islamic audio hub with prayer times and Flow triggers" },
  "category": ["tools"],
  "tags": {
    "en": ["prayer", "adhan", "quran", "islamic", "fajr", "isha", "asr", "maghrib", "dhuhr"]
  },
  "permissions": [
    "homey:manager:geolocation"
  ],
  "images": {
    "small": "/assets/images/small.jpg",
    "large": "/assets/images/large.jpg"
  },
  "brandColor": "#1B6B3A",
  "author": { "name": "dpanet", "email": "dpanet@gmail.com" },
  "api": {
    "previewTimes":    { "method": "GET",  "path": "/previewTimes"    },
    "searchCity":      { "method": "GET",  "path": "/searchCity"      },
    "getLocation":     { "method": "GET",  "path": "/location"        },
    "getStatus":       { "method": "GET",  "path": "/status"          },
    "reschedule":      { "method": "POST", "path": "/reschedule"      },
    "widgetData":      { "method": "GET",  "path": "/widgetData"      }
  }
}
